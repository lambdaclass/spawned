Planted bug 14 (exit-shutdown-reports-normal): An administrative Shutdown stop (ChildHandle::stop_with_reason(Shutdown); `shutdown()` before 0.8) commits Normal

diff --git a/concurrency/src/child_handle.rs b/concurrency/src/child_handle.rs
index 3b94d213..541fee9c 100644
--- a/concurrency/src/child_handle.rs
+++ b/concurrency/src/child_handle.rs
@@ -170,6 +170,11 @@ impl ChildHandle {
     /// runs. `stop_with_reason(Kill)` ends `Kill`; use [`kill`](Self::kill)
     /// for the untrappable kill signal that ends `Killed`.
     pub fn stop_with_reason(&self, reason: ExitReason) {
+        let reason = if reason == ExitReason::Shutdown {
+            ExitReason::Normal
+        } else {
+            reason
+        };
         crate::link::stop_with_reason(self.target.id, &self.target.request, reason, || {
             (self.target.wake)()
         });
